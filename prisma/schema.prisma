generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A league event (one per JustGo competition Thom played in)
model Event {
  id           String   @id // JustGo event ID, e.g. "55659"
  name         String
  eventDate    DateTime @map("event_date") @db.Date
  ratingBefore Int?     @map("rating_before")
  ratingAfter  Int      @map("rating_after")
  won          Int      @default(0)
  lost         Int      @default(0)
  notes        String?  @db.Text
  scrapedAt    DateTime @default(now()) @map("scraped_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  matches Match[]

  @@index([eventDate])
  @@map("events")
}

/// A known opponent, keyed by their USATT ID
model Opponent {
  usattId String  @id @map("usatt_id")
  name    String
  matches Match[]

  @@map("opponents")
}

/// An individual match result within an event
model Match {
  id               Int      @id @default(autoincrement())
  eventId          String   @map("event_id")
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  opponentUsattId  String   @map("opponent_usatt_id")
  opponent         Opponent @relation(fields: [opponentUsattId], references: [usattId])
  thomSets         Int      @map("thom_sets")
  opponentSets     Int      @map("opponent_sets")
  scoreString      String   @map("score_string") // e.g. "3-1", kept for posterity
  thomWon          Boolean  @map("thom_won")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([eventId])
  @@index([opponentUsattId])
  @@map("matches")
}

/// A live match recording session (admin-gated, point-by-point stats)
model LiveMatch {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  opponentName    String      @map("opponent_name")
  opponentUsattId String?     @map("opponent_usatt_id") // null = "pending" (unknown player)

  /// Date of the match (used to link to a JustGo event later)
  matchDate       DateTime    @map("match_date") @db.Date

  /// "left" | "right" — Thom's starting side on screen
  thomSide        String      @map("thom_side")
  /// "thom" | "opponent" — who won the toss
  tossWinner      String      @map("toss_winner")
  /// "thom" | "opponent" — who serves first (toss winner chooses)
  firstServer     String      @map("first_server")

  /// "active" | "complete"
  status          String      @default("active")

  /// Linked to a Match.id once the JustGo result is imported
  linkedMatchId   Int?        @map("linked_match_id")

  // Materialised current state — updated atomically with every point or manual adjustment
  curSetNumber    Int         @default(1)     @map("cur_set_number")
  curThomSetScore Int         @default(0)     @map("cur_thom_set_score")
  curOppSetScore  Int         @default(0)     @map("cur_opp_set_score")
  curThomSetsWon  Int         @default(0)     @map("cur_thom_sets_won")
  curOppSetsWon   Int         @default(0)     @map("cur_opp_sets_won")
  curMatchComplete Boolean    @default(false) @map("cur_match_complete")

  points          LivePoint[]

  @@map("live_matches")
}

/// A single point within a live match
model LivePoint {
  id            String    @id @default(cuid())
  liveMatchId   String    @map("live_match_id")
  liveMatch     LiveMatch @relation(fields: [liveMatchId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now()) @map("created_at")

  setNumber     Int       @map("set_number")   // 1–5
  pointInSet    Int       @map("point_in_set") // 1-indexed within the set
  serverThom    Boolean   @map("server_thom")  // true = Thom serves this point
  thomWon       Boolean   @map("thom_won")

  // Score AFTER this point
  thomSetScore  Int       @map("thom_set_score")
  oppSetScore   Int       @map("opp_set_score")
  thomSetsWon   Int       @map("thom_sets_won")
  oppSetsWon    Int       @map("opp_sets_won")
  setComplete   Boolean   @default(false) @map("set_complete")
  matchComplete Boolean   @default(false) @map("match_complete")

  // Optional shot detail (can be patched after the point is saved)
  /// "loop"|"push"|"chop"|"smash"|"flick"|"block"|"drive"|"lob"|"serve_ace"|"other"
  shotType      String?   @map("shot_type")
  /// "thom" | "opponent" — who hit the last shot
  shotBy        String?   @map("shot_by")
  /// "winner" | "unforced_error" | "forced_error"
  pointType     String?   @map("point_type")

  @@index([liveMatchId])
  @@map("live_points")
}
